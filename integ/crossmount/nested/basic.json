    {
      "id": "nest_glob_does_not_descend_into_a_file",
      "seq": 950021,
      "targets": [
        "ram-nested"
      ],
      "command": "echo /data/t*/top.txt",
      "expect": {
        "exit": 0,
        "stdout": "/data/t*/top.txt\n",
