      "id": "nest_find_type_d_lists_boundaries",
      "seq": 950015,
      "targets": [
        "ram-nested"
      ],
      "command": "find /data -type d",
      "expect": {
        "exit": 0,
        "stdout": "/data\n/data/inner\n",
