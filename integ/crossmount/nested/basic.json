      "id": "nest_du_glob_reaches_child_mount",
      "seq": 950019,
      "targets": [
        "ram-nested"
      ],
      "command": "du /data/i*",
      "expect": {
        "exit": 0,
        "stdout": "5\t/data/inner\n",
        "stderr": ""
      }
    },
    {
      "id": "nest_midpath_glob_descends_child_mount",
      "seq": 950020,
      "targets": [
        "ram-nested"
      ],
      "command": "echo /data/*/leaf.txt",
      "expect": {
        "exit": 0,
        "stdout": "/data/inner/leaf.txt\n",
