{
  "cases": [
    {
      "id": "nest_seed",
      "seq": 950001,
      "targets": [
        "ram-nested"
      ],
      "command": "echo top > /data/top.txt && echo deep > /data/inner/leaf.txt && echo ghost > /ghost/deep/g.txt",
      "expect": {
        "exit": 0,
        "stdout": "",
        "stderr": ""
      }
    },
    {
      "id": "nest_parent_lists_child_mount",
      "seq": 950002,
      "targets": [
        "ram-nested"
      ],
      "command": "ls /data",
      "expect": {
        "exit": 0,
        "stdout": "inner\ntop.txt\n",
        "stderr": ""
      }
    },
    {
      "id": "nest_read_routes_longest_prefix",
      "seq": 950003,
      "targets": [
        "ram-nested"
      ],
      "command": "cat /data/inner/leaf.txt",
      "expect": {
        "exit": 0,
        "stdout": "deep\n",
        "stderr": ""
      }
    },
    {
      "id": "nest_child_mount_root_is_dir",
      "seq": 950004,
      "targets": [
        "ram-nested"
      ],
      "command": "test -d /data/inner && echo yes",
      "expect": {
        "exit": 0,
        "stdout": "yes\n",
        "stderr": ""
