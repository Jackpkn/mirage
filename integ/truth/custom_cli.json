{
  "runs": {
    "python": {
      "command": [
        "./python/.venv/bin/python",
        "examples/python/cli/pager.py"
      ]
    },
    "typescript": {
      "command": [
        "pnpm",
        "-C",
        "examples/typescript",
        "exec",
        "tsx",
        "cli/pager.ts"
      ]
    }
  },
  "exit": 0,
  "lines": [
    "$ type -t pager-eng",
    "cli",
    "",
    "$ pager-eng --help",
    "pager-eng: Task-specific incident CLI",
    "",
    "Usage: pager-eng [flags] <command> [<args>]",
    "",
    "Commands:",
    "  ack   Acknowledge an incident",
    "  list  List incidents for this installed account",
    "",
    "Flags:",
    "  --help  Show this help and exit",
    "",
    "$ pager-eng list",
    "[engineering] INC-101 open Database latency",
    "",
    "$ pager-support list",
    "[support] INC-202 open Checkout retries",
    "",
    "$ pager-eng ack INC-101 --by Mina",
    "[engineering] acknowledged INC-101 by Mina",
    "",
    "$ pager-eng list",
    "[engineering] INC-101 acknowledged-by=Mina Database latency",
    "",
    "$ pager-support list",
    "[support] INC-202 open Checkout retries",
    ""
  ]
}
