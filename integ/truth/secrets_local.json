{
  "runs": {
    "python": {
      "command": [
        "./python/.venv/bin/python",
        "-u",
        "examples/python/secrets/secrets_local.py"
      ]
    },
    "typescript": {
      "command": [
        "pnpm",
        "-C",
        "examples/typescript",
        "exec",
        "tsx",
        "secrets/secrets_local.ts"
      ]
    }
  },
  "exit": 0,
  "lines": [
    "=== a literal costs no fetch ===",
    "$ echo \"env is $MIRAGE_ENV\"",
    "  exit 0",
    "  out: env is demo",
    "",
    "=== a line naming no secret fetches nothing ===",
    "$ echo hello > /data/note.txt; cat /data/note.txt",
    "  exit 0",
    "  out: hello",
    "",
    "=== the value arrives for the line that reads it ===",
    "$ echo \"token: $API_TOKEN\"",
    "  exit 0",
    "  out: token: demo-token-abc123",
    "",
    "=== one source per instance: a dead one fails its own lines only ===",
    {
      "re": "secret fetch for MISSING from gone failed:.* dotenv file not found: .*absent\\.env"
    },
    "$ echo \"missing: $MISSING\"",
    "  exit 1",
    "  err: MISSING: cannot fetch from gone",
    "",
    "$ echo \"and this line still runs: $DB_PASSWORD\"",
    "  exit 0",
    "  out: and this line still runs: demo-pw-xyz789",
    "",
    "=== what the session persisted ===",
    "env:",
    "  MIRAGE_ENV=demo",
    "  PWD=/",
    "managed (the pointer, never the value):",
    "  API_TOKEN from vault, key API_TOKEN",
    "  DB_PASSWORD from vault, key DB_PASSWORD",
    "  MISSING from gone, key MISSING",
    "",
    "a fetched value reached the store: no"
  ]
}
