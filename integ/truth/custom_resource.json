{
  "runs": {
    "python": {
      "command": [
        "./python/.venv/bin/python",
        "examples/python/other/custom_resource.py"
      ]
    },
    "typescript": {
      "command": [
        "pnpm",
        "-C",
        "examples/typescript",
        "exec",
        "tsx",
        "other/custom_resource.ts"
      ]
    }
  },
