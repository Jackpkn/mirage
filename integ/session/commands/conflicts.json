      "expect": {
        "exit": 0,
        "stdout": "",
        "stderr": ""
      }
    },
    {
      "id": "conflict_allow_and_deny_on_one_path_the_deny_speaks",
      "seq": 923067,
      "targets": [
        "ram-commands"
      ],
      "command": "rm /repo/letters.txt",
      "expect": {
        "exit": 1,
        "stdout": "",
        "stderr": "rm: /repo/letters.txt: no deletes in the repo\n"
      }
    },
    {
      "id": "conflict_the_allowed_head_still_works_elsewhere",
      "seq": 923068,
      "targets": [
        "ram-commands"
      ],
      "command": "rm /scratch/plain2 && echo gone",
      "expect": {
        "exit": 0,
        "stdout": "gone\n",
        "stderr": ""
      }
    },
    {
      "id": "conflict_deny_over_ask_on_one_subject_first_rule_of_the_tier",
      "seq": 923069,
      "targets": [
        "ram-commands"
      ],
      "session": "granted",
      "command": "rm /scratch/both/locked/y",
      "expect": {
        "exit": 1,
        "stdout": "",
        "stderr": "rm: /scratch/both/locked/y: both: locked\n"
      }
    },
    {
      "id": "conflict_the_ask_still_fires_beside_the_deny",
      "seq": 923070,
      "targets": [
        "ram-commands"
      ],
      "session": "granted",
      "command": "rm /scratch/both/a",
      "expect": {
        "exit": 126,
        "stdout": "",
        "stderr": "rm: requires approval: both: needs a nod (approval d2c4107e8cd1)\n"
      }
    },
    {
      "id": "conflict_a_session_grant_answers_the_ask",
